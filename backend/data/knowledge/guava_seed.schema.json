{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guava_seed.schema.json",
  "title": "Guava knowledge seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_on", "items", "gaps", "bibliography", "conflicts_index"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "generated_on": {"type": "string", "format": "date"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "bibliography": {"type": "array", "items": {"$ref": "#/$defs/bibliography_entry"}},
    "conflicts_index": {"type": "array", "items": {"$ref": "#/$defs/conflict_index_entry"}}
  },
  "$defs": {
    "topic": {
      "enum": [
        "varieties", "climate_soil", "planting_system", "propagation",
        "bahar_crop_regulation", "canopy_pruning", "nutrient_management", "irrigation",
        "flowering_fruit_set", "pests", "diseases", "harvest_maturity",
        "post_harvest", "yield", "economics"
      ]
    },
    "access": {"enum": ["opened_read", "opened_partial", "found_not_opened", "pdf_unreadable"]},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tree_age_months_min": {"type": "integer", "minimum": 0},
        "tree_age_months_max": {"type": "integer", "minimum": 0},
        "months": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}, "uniqueItems": true},
        "bahar": {"enum": ["ambe", "mrig", "hasta", "any"]},
        "irrigation_type": {"type": "string", "maxLength": 60},
        "planting_system": {"type": "string", "maxLength": 60},
        "varieties": {"type": "array", "items": {"type": "string", "maxLength": 60}}
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "anyOf": [{"required": ["value"]}, {"required": ["min"]}, {"required": ["max"]}],
      "properties": {
        "name": {"type": "string", "maxLength": 80},
        "value": {"type": ["number", "string"]},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "unit": {"type": "string", "maxLength": 40},
        "per": {"type": "string", "maxLength": 80}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "year", "url", "page", "section_or_table", "quote", "access"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 200},
        "year": {"type": ["integer", "null"]},
        "url": {"type": "string", "pattern": "^https?://"},
        "page": {"type": ["string", "null"], "maxLength": 40},
        "section_or_table": {"type": "string", "minLength": 1, "maxLength": 200},
        "quote": {"type": "string", "minLength": 1, "maxLength": 200},
        "access": {"$ref": "#/$defs/access"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_title", "url", "quote", "note"],
      "properties": {
        "source_title": {"type": "string", "minLength": 1, "maxLength": 300},
        "url": {"type": "string", "pattern": "^https?://"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 200},
        "note": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "topic", "subtopic", "region", "applicability", "statement_en", "statement_hi",
        "hi_machine_translated", "hi_reviewed", "values", "risk_level", "involves_chemical",
        "cibrc_check_required", "sources", "source_confidence", "conflicts", "retrieved_on", "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^GUA-[A-Z]{3,6}-\\d{4}$"},
        "topic": {"$ref": "#/$defs/topic"},
        "subtopic": {"type": "string", "minLength": 1, "maxLength": 80},
        "region": {"enum": ["MP", "MH", "ALL"]},
        "applicability": {"$ref": "#/$defs/applicability"},
        "statement_en": {"type": "string", "minLength": 10, "maxLength": 600},
        "statement_hi": {"type": "string", "minLength": 5, "maxLength": 900},
        "hi_machine_translated": {"type": "boolean"},
        "hi_reviewed": {"type": "boolean"},
        "values": {"type": "array", "items": {"$ref": "#/$defs/value"}},
        "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "involves_chemical": {"type": "boolean"},
        "cibrc_check_required": {"type": "boolean"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "source_confidence": {"enum": ["official_guideline", "peer_reviewed", "secondary"]},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
        "retrieved_on": {"type": "string", "format": "date"},
        "status": {"const": "DRAFT"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "region", "missing_fact", "searched", "reason"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic"},
        "region": {"enum": ["MP", "MH", "ALL"]},
        "missing_fact": {"type": "string", "minLength": 1},
        "searched": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "bibliography_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "year", "url", "access", "notes"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "year": {"type": ["integer", "null"]},
        "url": {"type": "string", "pattern": "^https?://"},
        "access": {"$ref": "#/$defs/access"},
        "notes": {"type": "string"}
      }
    },
    "conflict_index_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_ids", "summary"],
      "properties": {
        "item_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^GUA-[A-Z]{3,6}-\\d{4}$"}},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
