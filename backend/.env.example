# ── Smart Farmer Backend — Environment Variables ────────────────────────────────
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Required for all environments:

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

GEMINI_API_KEY=your-google-gemini-api-key

# Optional — only needed if your Supabase project still uses the legacy
# HS256 shared secret for JWT signing (old projects).
# New Supabase projects use ECC P-256 via JWKS — leave this blank.
SUPABASE_JWT_SECRET=

# Mandi prices (Agmarknet via data.gov.in). Free key: register at https://data.gov.in
# and copy the API key from your account. Without it the daily price ingestion is skipped.
DATA_GOV_IN_API_KEY=
# Secret for POST /api/admin/market-prices/ingest (send as header X-Admin-Token).
# Leave blank to disable the manual trigger. Use a long random value.
PRICE_INGEST_ADMIN_TOKEN=
# data.gov.in does not answer Render's IPs, so the in-process mandi price cron is off by
# default (prices come from the Supabase Edge Function / PC script). Set to 1 to turn it on.
# MANDI_INGEST_ON_RENDER=1

# Knowledge admin: comma-separated emails that may become the FIRST admin (only while no
# active admin exists, and only with a confirmed Google email). Set it, sign in once on
# admin.html, then you can remove it. Never commit a real value.
# ADMIN_BOOTSTRAP_EMAILS=
