# ── Guava Care Backend — Environment Variables ────────────────────────────────
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Required for all environments:

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

GEMINI_API_KEY=your-google-gemini-api-key

# Optional — only needed if your Supabase project still uses the legacy
# HS256 shared secret for JWT signing (old projects).
# New Supabase projects use ECC P-256 via JWKS — leave this blank.
SUPABASE_JWT_SECRET=
